# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/antaraerp?schema=public"
# Direct/unpooled connection for migrations; never pass Prisma-only params to pg_dump.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/antara

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth (web)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"


# API
API_URL="http://localhost:4000/api"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
FRONTEND_URL="http://localhost:3000"

# JWT (api)
JWT_ACCESS_SECRET="replace-with-openssl-rand-base64-32"
JWT_REFRESH_SECRET="replace-with-openssl-rand-base64-32"


# Google OAuth (for NextAuth login)
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"
# Backend-only bootstrap/emergency fallback. Normal active/invited users use People onboarding.
# Pending identities require a valid invitation or this explicit fallback; no automatic grants.
GOOGLE_ALLOWED_EMAILS=""

# Google Service Account (for Calendar + Drive)
GOOGLE_PROJECT_ID="replace-me"
GOOGLE_SERVICE_ACCOUNT_EMAIL="replace-me"
GOOGLE_PRIVATE_KEY="replace-me"
GOOGLE_CALENDAR_ID="replace-me"
GOOGLE_DRIVE_ROOT_FOLDER_ID="replace-me"

# Email Notifications (Resend)
# Optional for invitations: disabled/unavailable delivery still returns a one-time Copy Link.
# Queue payloads temporarily contain bearer links; protect Redis and never log payloads.
RESEND_API_KEY="replace-me"
NOTIFICATIONS_EMAIL_ENABLED="false"
NOTIFICATIONS_FROM_EMAIL="noreply@antaraerp.local"


# Local dummy password-login allowlist; always disabled when NODE_ENV=production.
ENFORCE_DUMMY_ALLOWLIST=false

# Phase 6 private storage: providers are explicitly enabled; no local fallback.
# Drive uses GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_PRIVATE_KEY / GOOGLE_DRIVE_ROOT_FOLDER_ID above.
STORAGE_DRIVE_ENABLED=false
STORAGE_S3_ENABLED=false
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=antara-v1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
STORAGE_RETENTION_DAYS=30
STORAGE_SIGNED_URL_TTL_SECONDS=60
STORAGE_MAX_UPLOAD_BYTES=104857600

# Optional v1 inference: explicit infrastructure configuration, no cloud fallback.
AI_ENABLED=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=5000
AI_WORKER_ENABLED=true

# General API budgets, single API process; auth-specific limits are independent.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_USER_MAX=180
API_RATE_LIMIT_PUBLIC_SOURCE_MAX=60
# Capacity assumption: 20 simultaneously busy accounts at 180 requests/minute.
API_RATE_LIMIT_SOURCE_FLOOD_MAX=3600
