# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/antaraerp?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth (web)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"


# API
API_URL="http://localhost:4000/api"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
FRONTEND_URL="http://localhost:3000"

# JWT (api)
JWT_ACCESS_SECRET="replace-with-openssl-rand-base64-32"
JWT_REFRESH_SECRET="replace-with-openssl-rand-base64-32"

# OpenAI
OPENAI_API_KEY="replace-me"
OPENAI_MODEL="gpt-4.1-mini"

# Google OAuth (for NextAuth login)
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"
GOOGLE_ALLOWED_EMAILS="you@bits-pilani.ac.in,teammate@bits-pilani.ac.in"

# Google Service Account (for Calendar + Drive)
GOOGLE_PROJECT_ID="replace-me"
GOOGLE_SERVICE_ACCOUNT_EMAIL="replace-me"
GOOGLE_PRIVATE_KEY="replace-me"
GOOGLE_CALENDAR_ID="replace-me"
GOOGLE_DRIVE_ROOT_FOLDER_ID="replace-me"

# Email Notifications (Resend)
RESEND_API_KEY="replace-me"
NOTIFICATIONS_EMAIL_ENABLED="false"
NOTIFICATIONS_FROM_EMAIL="noreply@antaraerp.local"

